.page{padding:28rpx;background:#f5fbf7;min-height:100vh}.hero{padding:30rpx;border-radius:24rpx;background:#e8f8ee}.hero>text{font-size:26rpx;color:#4e695a}.hero>view{font-size:52rpx;font-weight:700;margin:16rpx 0}.small{font-size:22rpx!important;color:#8b9c91!important}.progress,.line{height:14rpx;background:#d5ebdd;border-radius:8rpx;margin:14rpx 0}.progress view{width:78%;height:100%;background:#44c38a;border-radius:8rpx}.head{display:flex;justify-content:space-between;font-size:32rpx;font-weight:600;margin:34rpx 4rpx 18rpx}.muted{font-size:24rpx;color:#8d9b93;font-weight:400}.card{display:flex;align-items:center;background:#fff;border-radius:20rpx;padding:22rpx;margin-bottom:14rpx}.emoji{font-size:42rpx;margin-right:20rpx}.main{flex:1}.main>text{display:block;margin-bottom:8rpx}.line{margin:10rpx 0 0}.line view{height:100%;background:#f6b15e;border-radius:8rpx}
