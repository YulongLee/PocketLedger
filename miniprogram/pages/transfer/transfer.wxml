<view class="page"><view class="intro"><text class="title">账户转账</text><text class="sub">在自己的账户之间移动资金</text></view><view class="transfer-card"><text class="label">转出账户</text><picker mode="selector" range="{{accounts}}" range-key="name" value="{{fromIndex}}" bindchange="fromChange"><view class="picker"><view><text class="account-name">{{accounts[fromIndex].name||'请选择账户'}}</text><text class="balance">余额 ¥{{accounts[fromIndex].displayBalance||'0.00'}}</text></view><text>⌄</text></view></picker><view class="swap" bindtap="swap">⇅</view><text class="label">转入账户</text><picker mode="selector" range="{{accounts}}" range-key="name" value="{{toIndex}}" bindchange="toChange"><view class="picker"><view><text class="account-name">{{accounts[toIndex].name||'请选择账户'}}</text><text class="balance">余额 ¥{{accounts[toIndex].displayBalance||'0.00'}}</text></view><text>⌄</text></view></picker></view><view class="amount-card"><text class="label">转账金额</text><view class="amount"><text>¥</text><input type="digit" focus placeholder="0.00" value="{{amount}}" bindinput="amountInput"/></view><view class="note"><text>备注</text><input placeholder="可选，如：信用卡还款" value="{{note}}" bindinput="noteInput"/></view></view><button class="submit" bindtap="submit">确认转账</button></view>
