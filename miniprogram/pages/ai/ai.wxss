.page{padding:30rpx;background:#f5fbf7;min-height:100vh}.hello{background:#fff;border-radius:20rpx;padding:24rpx;margin-bottom:22rpx;font-size:29rpx}.hello text{display:block;color:#8c9b92;font-size:23rpx;margin-top:12rpx}.bubble{max-width:78%;padding:20rpx 24rpx;border-radius:22rpx;margin:14rpx 0;font-size:27rpx}.bubble.user{margin-left:auto;background:#d7f6e4}.bubble.ai{background:#fff}.result{background:#fff;border-radius:22rpx;padding:24rpx;margin-top:20rpx}.result-title{font-weight:600}.draft{display:flex;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid #eef2ef}.result button{background:#44c38a;color:#fff;margin-top:20rpx}.inputbar{position:fixed;bottom:28rpx;left:5%;width:90%;display:flex;background:#fff;border-radius:50rpx;padding:8rpx 10rpx 8rpx 26rpx;box-sizing:border-box;box-shadow:0 8rpx 24rpx #b8d8c5}.inputbar input{flex:1}.inputbar button{background:#44c38a;color:#fff;border-radius:36rpx;font-size:24rpx}
.ai-avatar{width:58rpx;height:58rpx;border-radius:50%;vertical-align:middle;margin-right:10rpx}
