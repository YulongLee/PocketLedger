.page{padding:28rpx;background:#f5fbf7;min-height:100vh}.switch{display:flex;background:#e8f1ec;border-radius:30rpx;padding:6rpx}.switch text{flex:1;text-align:center;padding:14rpx;color:#728078}.switch .on{background:#fff;color:#288e67;border-radius:24rpx;font-weight:600}.period{font-size:28rpx;margin:28rpx 4rpx}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:22rpx}.total{font-size:48rpx;font-weight:700}.muted{color:#9aa6a0;font-size:24rpx}.donut{width:260rpx;height:260rpx;margin:34rpx auto;border-radius:50%;background:conic-gradient(#4b9cf0 0 32%,#f58b92 32% 50%,#71c6c8 50% 62%,#8d9fe6 62% 72%,#ac85d5 72% 80%,#f5bc5b 80% 100%);display:flex;align-items:center;justify-content:center}.donut:before{content:'';width:150rpx;height:150rpx;border-radius:50%;background:#fff}.donut-text{position:absolute;text-align:center;font-size:24rpx}.donut-text text{display:block;font-size:28rpx;font-weight:700;margin-top:8rpx}.legend{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;color:#66736c;font-size:24rpx}.title{font-size:30rpx;font-weight:600}.bars{height:180rpx;display:flex;align-items:flex-end;gap:18rpx;padding:30rpx 10rpx 0}.bars view{flex:1;background:#74d8a5;border-radius:8rpx 8rpx 0 0}
