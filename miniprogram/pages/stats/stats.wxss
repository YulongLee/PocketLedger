page{background:#f5f9f8;color:#11213a;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}
.stats-page{background:linear-gradient(165deg,#effff8 0,#f8fcfb 440rpx,#f5f8f8 860rpx);min-height:100%;padding-bottom:20rpx}
.navigation{display:flex;align-items:center;padding-left:32rpx;padding-right:200rpx;box-sizing:content-box}.nav-title{font-size:38rpx;font-weight:700}.back{width:44rpx;height:70rpx;display:flex;align-items:center}.back-chevron{width:15rpx;height:15rpx;border-left:3rpx solid #243652;border-bottom:3rpx solid #243652;transform:rotate(45deg)}
.stats-content{padding:12rpx 28rpx 0}.period-tabs{display:flex;justify-content:flex-end;gap:12rpx;margin:6rpx 0 12rpx}.period-tab{min-width:105rpx;box-sizing:border-box;text-align:center;background:rgba(255,255,255,.88);padding:13rpx 24rpx;border-radius:40rpx;font-size:24rpx;color:#8290a8}.period-tab.active,.analysis-tabs .active,.month-grid .active{color:#fff;background:linear-gradient(135deg,#21dba0,#00b97e);box-shadow:0 6rpx 16rpx rgba(7,192,130,.13)}
.period-trigger{display:flex;align-items:center;justify-content:center;gap:14rpx;width:fit-content;max-width:100%;margin:16rpx auto 12rpx;padding:12rpx 24rpx;border-radius:36rpx;background:#edf2f5;color:#536584;font-size:24rpx}.down-chevron{width:10rpx;height:10rpx;border-right:2rpx solid #73839c;border-bottom:2rpx solid #73839c;transform:rotate(45deg);margin-top:-5rpx}.period-note{display:block;text-align:center;color:#8997aa;font-size:20rpx;margin:0 0 20rpx;line-height:1.5}
.card{padding:26rpx;background:#fff;border-radius:28rpx;margin-bottom:22rpx;box-shadow:0 5rpx 20rpx rgba(45,85,69,.025)}.summary-card{display:flex;padding:26rpx 4rpx;background:#fff;border-radius:28rpx;margin-bottom:18rpx}.summary-part{flex:1;padding:0 24rpx;min-width:0}.summary-part+.summary-part{border-left:1rpx solid #edf1f6}.sub-label{display:block;font-size:25rpx;color:#657692}.summary-value{display:block;font-size:34rpx;font-weight:700;letter-spacing:-.7rpx;margin:10rpx 0;overflow-wrap:break-word}.change{font-size:21rpx;color:#76859c;display:block}.change.expense{color:#0fb87b}.balance-banner{position:relative;overflow:hidden;padding:24rpx 28rpx;border-radius:28rpx;margin-bottom:24rpx;min-height:194rpx;box-sizing:border-box;color:#fff;background:linear-gradient(115deg,#0fbc84,#20d99b);box-shadow:0 10rpx 24rpx rgba(16,188,132,.1)}.balance-copy{position:relative;z-index:2;width:72%}.banner-label{display:block;font-size:26rpx}.banner-value{display:block;font-size:46rpx;font-weight:700;margin:8rpx 0 10rpx;letter-spacing:-1rpx}.banner-note{display:block;font-size:22rpx;opacity:.95}.banner-motto{display:block;margin-top:8rpx;font-size:20rpx;color:#defff2}.inline-arrow{margin-left:8rpx}.banner-mascot{position:absolute;width:210rpx;height:230rpx;right:0;bottom:-22rpx;z-index:1}.banner-circle{position:absolute;width:260rpx;height:260rpx;background:rgba(223,255,239,.19);right:-45rpx;top:-45rpx;border-radius:50%}
.card-head{display:flex;justify-content:space-between;align-items:center;gap:12rpx;margin-bottom:18rpx}.section-title{font-size:28rpx;font-weight:650}.more,.small-note{font-size:21rpx;color:#8896ac}.chart-toggle{display:flex;background:#f3f6f8;border-radius:28rpx;padding:4rpx;font-size:21rpx;color:#8490a6}.chart-toggle text{padding:9rpx 15rpx;border-radius:24rpx}.chart-toggle .active{background:#e0f8ed;color:#0bb77e}.chart-legend{display:flex;gap:22rpx;align-items:center;font-size:22rpx;color:#74829c;margin-bottom:6rpx}.chart-legend text{display:flex;align-items:center;gap:8rpx}.dot{display:inline-block;flex-shrink:0;width:15rpx;height:15rpx;border-radius:50%}.unit{margin-left:auto;font-size:19rpx}.trend-canvas{display:block;width:100%;height:310rpx}.chart-tip{display:block;text-align:center;color:#8798ad;font-size:19rpx;margin-top:14rpx;min-height:26rpx}.distribution-content{display:flex;align-items:center;gap:14rpx}.ring-wrap{position:relative;flex-shrink:0;width:100%;height:400rpx}.ring-canvas{width:100%;height:100%}.ring-center{position:absolute;left:19%;right:19%;top:50%;transform:translateY(-50%);text-align:center;pointer-events:none}.ring-value{display:block;font-size:32rpx;font-weight:700;letter-spacing:-.5rpx}.ring-caption{display:block;margin-top:8rpx;font-size:22rpx;color:#8490a7}.overview-distribution .ring-wrap{width:52%;height:300rpx}.overview-distribution .ring-value{font-size:25rpx}.overview-distribution .ring-caption{font-size:20rpx}.overview-distribution .ring-center{left:9%;right:9%}.compact-legend{flex:1;min-width:0;font-size:22rpx;color:#7887a0}.compact-legend>view{display:flex;align-items:center;gap:10rpx;padding:9rpx 0}.compact-name{flex:1;color:#465972;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.analysis-tabs{display:flex;background:rgba(255,255,255,.92);border-radius:28rpx;padding:5rpx;margin:8rpx 0 22rpx;color:#7c8ba2;font-size:26rpx}.analysis-tabs>view{flex:1;text-align:center;padding:13rpx 0;border-radius:24rpx}.analysis-total{text-align:center;font-size:49rpx;font-weight:700;margin:18rpx 0 12rpx}.analysis-change{font-size:22rpx;color:#0bb882;text-align:center;display:block}.category-row{display:flex;align-items:center;gap:12rpx;padding:16rpx 0;font-size:25rpx}.category-name{display:flex;align-items:center;gap:12rpx;flex:1;min-width:0}.category-amount{font-weight:550}.category-percent{width:86rpx;text-align:right;color:#8490a7;font-size:23rpx}.row-arrow{color:#b1becb}.tap-hint{display:block;font-size:20rpx;color:#98a6b8;text-align:center;margin:20rpx 0 2rpx}.empty-hint{color:#9aa6b5;font-size:23rpx;display:block;text-align:center;padding:12rpx 0}.balance-detail{background:linear-gradient(120deg,#e7fcf3,#dffaf0);position:relative;overflow:hidden}.balance-total{display:block;font-size:48rpx;font-weight:700;margin:10rpx 0 12rpx}.balance-detail .analysis-change{text-align:left}.balance-mascot{width:155rpx;height:170rpx;position:absolute;right:8rpx;top:40rpx}.rate-label{font-size:24rpx;color:#61748e;margin-top:46rpx}.rate-label text{font-weight:650;margin-left:10rpx;color:#1d5361}.rate-track{height:14rpx;border-radius:20rpx;background:#d4efe3;margin-top:18rpx;overflow:hidden;width:85%}.rate-track>view{height:100%;border-radius:20rpx;background:linear-gradient(90deg,#18c48a,#34dca3)}.rate-note{display:block;font-size:19rpx;color:#8497a3;margin-top:12rpx}.month-row{display:flex;justify-content:space-between;gap:12rpx;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #f1f4f6;font-size:24rpx;color:#657892}.month-row:last-child{border:0}.month-value{color:#24394f;font-weight:550}.insight-head{display:flex;align-items:center;gap:14rpx;margin-bottom:6rpx}.insight-head image{height:48rpx;width:48rpx;border-radius:50%;background:#dcf9ed}.insight-row{display:flex;gap:16rpx;align-items:flex-start;padding:20rpx 0;border-bottom:1rpx solid #f1f5f4;font-size:23rpx;line-height:1.7;color:#71829a}.insight-bullet{width:10rpx;height:10rpx;background:#2bc58d;border-radius:50%;flex:none;margin-top:15rpx}.insight-footnote{display:block;text-align:right;font-size:19rpx;color:#9aa8b6;padding-top:16rpx}.status-card{text-align:center;margin:80rpx 0;color:#81928d;font-size:26rpx}.status-card text{display:block}.retry{background:#e1f6ec;color:#118d63;margin:24rpx auto;border-radius:40rpx;font-size:26rpx;width:240rpx}
.sheet-mask{position:fixed;top:0;right:0;bottom:0;left:0;z-index:99;background:rgba(15,31,40,.32);display:flex;align-items:flex-end}.sheet{width:100%;max-height:85vh;box-sizing:border-box;padding:16rpx 34rpx 32rpx;background:#fff;border-radius:36rpx 36rpx 0 0;box-shadow:0 -10rpx 60rpx rgba(25,65,46,.07)}.sheet-handle{width:70rpx;height:7rpx;border-radius:20rpx;background:#dce2e7;margin:0 auto 16rpx}.sheet-head{display:flex;align-items:center;justify-content:space-between;font-size:32rpx;font-weight:650;margin-bottom:16rpx}.sheet-close{font-size:44rpx;font-weight:300;color:#8b98a7;padding:5rpx 12rpx}.year-picker{display:flex;align-items:center;justify-content:space-between;padding:12rpx 0 18rpx;font-size:29rpx;font-weight:600}.year-picker>view{padding:8rpx 22rpx;font-size:42rpx;color:#789387}.month-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20rpx}.month-grid>view{text-align:center;background:#f4f6f8;padding:16rpx 0;border-radius:20rpx;font-size:26rpx;color:#6e8099}.month-grid>view.active{color:#fff}.confirm{margin-top:32rpx;border-radius:28rpx;background:#13c388;color:white;font-size:28rpx;font-weight:600}.confirm::after,.retry::after{border:0}.date-inputs picker{display:block;padding:24rpx 0;border-bottom:1rpx solid #eef3f1;font-size:26rpx}.date-inputs picker text+text{float:right;color:#438975}.category-summary{display:flex;align-items:center;justify-content:space-between;background:#edfbf5;padding:24rpx;border-radius:22rpx;margin-bottom:16rpx}.category-summary text:first-child{font-size:36rpx;font-weight:650}.category-summary text+text{font-size:24rpx;color:#19b985}.detail-scroll{height:50vh}.detail-row{display:flex;align-items:center;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid #eff4f1;gap:24rpx}.detail-title{display:block;font-size:27rpx}.detail-date{display:block;font-size:22rpx;color:#93a0b3;margin-top:10rpx}.detail-money{font-size:26rpx;font-weight:600;white-space:nowrap}
.preview-button{color:#688b80;background:transparent;font-size:24rpx;margin:12rpx auto;width:260rpx}.preview-button::after{border:0}.preview-notice{display:flex;justify-content:space-between;gap:12rpx;font-size:20rpx;color:#9c7436;background:#fff7e8;border-radius:16rpx;padding:13rpx 18rpx;margin:14rpx 0}.preview-notice text+text{color:#278f71}
.legend-entry{display:flex;gap:8rpx;align-items:center}.category-chart-legend{flex-wrap:wrap;gap:14rpx 22rpx}.category-metric{display:flex;justify-content:flex-end;margin-bottom:16rpx}.category-metric .chart-toggle text{padding-left:22rpx;padding-right:22rpx}
