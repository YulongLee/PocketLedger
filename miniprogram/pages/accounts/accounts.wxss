page{background:#f5fff9}.page{min-height:100vh;padding:34rpx 30rpx 80rpx;box-sizing:border-box}.header{display:flex;align-items:center;justify-content:space-between}.eyebrow{display:block;font-size:22rpx;color:#7f9588}.title{display:block;font-size:42rpx;font-weight:700;margin-top:4rpx}.header-actions{display:flex;align-items:center;gap:16rpx}.header-actions button{font-size:23rpx;color:#2fae78;background:#e3f8ec;border-radius:24rpx;padding:0 24rpx;height:60rpx;line-height:60rpx}.header-actions>text{width:58rpx;height:58rpx;line-height:52rpx;text-align:center;border-radius:50%;background:#42c58c;color:#fff;font-size:42rpx;font-weight:300}.summary{margin-top:30rpx;padding:34rpx;border-radius:26rpx;background:linear-gradient(135deg,#e5faee,#fff);border:1rpx solid #c3ecd3;box-shadow:0 12rpx 30rpx rgba(70,170,120,.08)}.summary>text:first-child{display:block;color:#668174;font-size:25rpx}.total{display:block;color:#172b20;font-size:58rpx;font-weight:700;margin:8rpx 0}.hint{display:block;color:#91a49a;font-size:22rpx}.section-title{display:flex;justify-content:space-between;align-items:center;margin:38rpx 4rpx 16rpx;font-size:30rpx;font-weight:700}.muted{font-size:23rpx;color:#96a69d;font-weight:400}.account-card{display:flex;align-items:center;padding:26rpx 22rpx;margin-bottom:16rpx;background:#fff;border-radius:22rpx;border:1rpx solid #e4f1e8;box-shadow:0 6rpx 20rpx rgba(26,90,55,.04)}.account-icon{width:74rpx;height:74rpx;display:flex;align-items:center;justify-content:center;border-radius:20rpx;background:#edfaf2;font-size:36rpx;margin-right:20rpx}.account-info{flex:1}.account-name{display:block;font-size:29rpx;font-weight:600}.account-type{display:block;font-size:22rpx;color:#9aa9a0;margin-top:6rpx}.account-balance{font-size:30rpx;font-weight:600;color:#233c2d}.add-account{margin-top:28rpx;height:84rpx;line-height:84rpx;border:1rpx dashed #89d8ae;border-radius:18rpx;background:#edfcf3;color:#31ad76;font-size:28rpx}.tip{margin:26rpx 6rpx;color:#91a39a;font-size:22rpx;line-height:1.6}.mask{position:fixed;inset:0;background:rgba(20,45,32,.28);display:flex;align-items:flex-end;z-index:10}.sheet{width:100%;box-sizing:border-box;padding:34rpx 34rpx 50rpx;background:#fff;border-radius:30rpx 30rpx 0 0}.sheet-title{display:flex;justify-content:space-between;font-weight:700;font-size:34rpx;margin-bottom:28rpx}.sheet-title text{font-size:42rpx;color:#9aaba1;font-weight:300}.name-input{height:86rpx;padding:0 24rpx;border-radius:16rpx;background:#f6faf7;font-size:28rpx}.label{display:block;color:#789083;font-size:23rpx;margin:24rpx 0 14rpx}.types{display:grid;grid-template-columns:repeat(5,1fr);gap:10rpx}.type{padding:14rpx 2rpx;text-align:center;border-radius:14rpx;background:#f7faf8;color:#70867a;font-size:19rpx}.type text:first-child{display:block;font-size:28rpx;margin-bottom:6rpx}.type.selected{background:#d9f6e5;color:#1ca96f;box-shadow:inset 0 0 0 2rpx #47c58c}.balance-input{display:flex;align-items:center;gap:12rpx;height:86rpx;padding:0 24rpx;background:#f6faf7;border-radius:16rpx;font-size:32rpx}.balance-input input{flex:1;font-size:32rpx}.confirm{margin-top:32rpx;background:#42c58c;color:#fff;height:84rpx;line-height:84rpx;border-radius:16rpx}
