<view class="page"><view class="tabs"><text class="{{type==='expense'?'active':''}}" bindtap="setType" data-type="expense">支出</text><text class="{{type==='income'?'active':''}}" bindtap="setType" data-type="income">收入</text><text>转账</text></view><view class="amount"><text>¥</text><input type="digit" placeholder="0.00" value="{{amount}}" bindinput="amountInput" focus/></view><text class="account">零钱　○</text><view class="cat-grid"><view wx:for="{{categories}}" wx:key="name" class="cat {{index===index?'selected':''}}" bindtap="cat" data-index="{{index}}"><text>{{item.icon}}</text><text>{{item.name}}</text></view></view><view class="form"><view><text>备注</text><input placeholder="添加备注..." value="{{note}}" bindinput="noteInput"/></view><view><text>日期</text><text>今天　12:30 ›</text></view><view><text>支付方式</text><text>微信支付 ›</text></view></view><button bindtap="save">完成</button></view>
