page{background:#fff}.page{padding:28rpx 28rpx 50rpx}.tabs{display:flex;justify-content:center;gap:70rpx;padding:10rpx 0 20rpx;border-bottom:1rpx solid #edf2ef}.tabs text{font-size:29rpx;color:#7d8c83;padding:12rpx}.tabs .active{color:#1e3127;font-weight:700;border-bottom:5rpx solid #44c58b}.amount{display:flex;align-items:center;gap:12rpx;padding:35rpx 5rpx 8rpx;font-size:44rpx}.amount input{font-size:58rpx;flex:1;font-weight:700}.account{display:block;color:#8c9c92;font-size:23rpx;margin:0 0 24rpx 8rpx}.cat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22rpx 12rpx}.cat{text-align:center;color:#64766a;font-size:22rpx}.cat text:first-child{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;margin:0 auto 7rpx;border-radius:18rpx;background:#f7faf8;font-size:32rpx}.cat.selected text:first-child{background:#bcefd3;box-shadow:inset 0 0 0 2rpx #58c995}.form{margin-top:30rpx;background:#fafdfb;border-radius:18rpx;padding:0 22rpx}.form view{display:flex;justify-content:space-between;padding:25rpx 0;border-bottom:1rpx solid #eaf1ec;color:#52675a;font-size:26rpx}.form input{text-align:right}.page button{margin-top:32rpx;background:#43c58c;color:#fff;border-radius:14rpx;height:88rpx;line-height:88rpx}
