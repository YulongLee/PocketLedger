page{background:rgba(17,24,39,.52)}.sheet-page{min-height:100vh;position:relative;background:rgba(17,24,39,.52)}.scrim{position:absolute;inset:0}.sheet{position:absolute;left:0;right:0;bottom:0;min-height:760rpx;padding:20rpx 36rpx 54rpx;background:#fff;border-radius:34rpx 34rpx 0 0;box-sizing:border-box;box-shadow:0 -10rpx 40rpx rgba(0,0,0,.14)}.grabber{width:92rpx;height:10rpx;margin:0 auto 24rpx;background:#d9e0e5;border-radius:99rpx}.sheet-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:26rpx}.sheet-title{font-size:40rpx;font-weight:700;color:#101828}.close{font-size:58rpx;line-height:50rpx;color:#758393;font-weight:300}.option{display:flex;align-items:center;gap:22rpx;padding:24rpx 6rpx;border-bottom:1rpx solid #edf1f4}.option-primary{margin-bottom:4rpx;padding:28rpx 18rpx;background:#e8faf2;border-radius:24rpx;border:0}.option image{width:88rpx;height:88rpx;flex:none}.option-title{display:block;font-size:32rpx;font-weight:650;color:#101828}.option-sub{display:block;margin-top:6rpx;color:#718096;font-size:24rpx}.option>view{flex:1}.chevron{font-size:46rpx;color:#8290a0}.last{border-bottom:0}.manual{min-height:900rpx}.tabs{display:flex;gap:68rpx;border-bottom:1rpx solid #edf1f4}.tabs text{padding:14rpx 8rpx;font-size:30rpx;color:#8290a0}.tabs .active{color:#111827;font-weight:700;border-bottom:5rpx solid #20c77b}.amount{display:flex;align-items:center;gap:14rpx;padding:34rpx 4rpx 20rpx;font-size:46rpx}.amount input{flex:1;font-size:62rpx;font-weight:700}.cat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20rpx 10rpx}.cat{text-align:center;color:#64748b;font-size:22rpx}.cat text:first-child{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;margin:0 auto 8rpx;border-radius:20rpx;background:#f4f8f6;font-size:32rpx}.cat.selected text:first-child{background:#c9f3dd;box-shadow:inset 0 0 0 2rpx #4ac990}.note{margin-top:28rpx;padding:22rpx;background:#f7faf8;border-radius:16rpx;font-size:25rpx}.sheet button{margin-top:28rpx;height:88rpx;line-height:88rpx;color:#fff;background:#24c783;border-radius:18rpx}
