page{background:#f2fff7}.screen{min-height:100vh;padding:18rpx 24rpx 120rpx;background:linear-gradient(180deg,#eafff2 0,#f8fffb 35%)}.nav{height:74rpx;display:flex;align-items:center;justify-content:space-between}.nav-title{font-size:34rpx;font-weight:800;letter-spacing:1rpx}.nav-actions{display:flex;gap:22rpx;color:#6d8f7d;font-size:26rpx}.hero{height:150rpx;position:relative}.speech{position:absolute;left:12rpx;top:20rpx;background:rgba(255,255,255,.72);padding:16rpx 22rpx;border-radius:24rpx;color:#557265;font-size:23rpx;box-shadow:0 4rpx 14rpx rgba(91,172,122,.06)}.speech text{display:block;font-size:19rpx;margin-top:5rpx}.hero-img{position:absolute;right:20rpx;top:-24rpx;width:168rpx;height:168rpx;border-radius:50%}.money-card{background:#fff;border:2rpx solid #a6e9c2;border-radius:24rpx;padding:24rpx 25rpx;box-shadow:0 6rpx 18rpx rgba(72,170,112,.08)}.money-head{display:flex;justify-content:space-between;align-items:center;color:#4a6657;font-size:24rpx}.money-head button{background:#43c68d;color:#fff;border-radius:28rpx;font-size:22rpx;padding:8rpx 18rpx;line-height:1}.money{display:block;font-size:48rpx;font-weight:800;margin:14rpx 0}.money-foot{display:flex;justify-content:space-between;color:#738c7d;font-size:22rpx}.quick{display:grid;grid-template-columns:repeat(4,1fr);padding:22rpx 4rpx 10rpx}.quick>view{text-align:center;color:#586f62;font-size:22rpx}.quick-icon{width:65rpx;height:65rpx;line-height:65rpx;margin:0 auto 8rpx;border-radius:18rpx;background:#fff;font-size:31rpx;box-shadow:0 4rpx 12rpx rgba(71,126,91,.08)}.q0{background:#ffe7ea}.q1{background:#fff0c9}.q2{background:#e7f0ff}.q3{background:#e7f8ea}.trend-card{background:#fff;border-radius:22rpx;padding:22rpx 20rpx 16rpx}.section{display:flex;justify-content:space-between;align-items:center;font-size:28rpx;font-weight:700}.trend-total{font-size:28rpx;margin-right:12rpx}.green{font-size:19rpx;color:#34ab74;font-weight:400}.chart{height:110rpx;display:flex;align-items:flex-end;gap:15rpx;padding-top:20rpx}.chart view{flex:1;background:#6ed5a0;border-radius:6rpx 6rpx 0 0}.dates{display:flex;justify-content:space-between;color:#a0aea5;font-size:17rpx}.recent{margin:25rpx 3rpx 14rpx}.muted{font-size:21rpx;color:#96a69c;font-weight:400}.record{display:flex;align-items:center;background:#fff;border-radius:17rpx;padding:17rpx 18rpx;margin-bottom:11rpx}.record-icon{width:52rpx;height:52rpx;line-height:52rpx;text-align:center;border-radius:15rpx;background:#ffe4e6;font-size:28rpx;margin-right:14rpx}.record-main{flex:1;display:flex;flex-direction:column;gap:5rpx;font-size:25rpx}.note{font-size:20rpx;color:#a1aea6}.record-amount{font-size:26rpx;font-weight:700}.income{color:#21b071}.empty{text-align:center;color:#9aa9a0;font-size:23rpx;padding:40rpx}.float-add{position:fixed;bottom:26rpx;left:calc(50% - 35rpx);width:70rpx;height:70rpx;line-height:70rpx;padding:0;border-radius:50%;background:#3fc58a;color:#fff;font-size:42rpx;box-shadow:0 8rpx 22rpx rgba(39,170,106,.28)}
