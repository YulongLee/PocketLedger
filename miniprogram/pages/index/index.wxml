<view class="screen"><view class="nav"><text class="nav-title">小帐同学</text><view class="nav-actions"><text>◉</text><text>◌</text></view></view><view class="hero"><view class="speech">早上好！<text>今天也要好好记账哦～</text></view><image class="hero-img" src="/assets/mascot-avatar.png" mode="aspectFill"/></view><view class="money-card"><view class="money-head"><text>本月支出</text><button bindtap="add">⌁ 记一笔</button></view><text class="money">¥ {{expense}}</text><view class="money-foot"><text>收入 ¥ {{income}}</text><text>结余 ¥ {{balance}}</text></view></view><view class="quick"><view wx:for="{{quick}}" wx:key="name" bindtap="add"><view class="quick-icon q{{index}}">{{item.icon}}</view><text>{{item.name}}</text></view></view><view class="trend-card"><view class="section"><text>本月消费趋势</text><view><text class="trend-total">¥{{expense}}</text><text class="green">较上月 ↑ 12%</text></view></view><view class="chart"><view wx:for="{{bars}}" wx:key="*this" style="height:{{item}}%"></view></view><view class="dates"><text>9.1</text><text>9.7</text><text>9.14</text><text>9.21</text><text>9.28</text></view></view><view class="section recent" bindtap="viewAll"><text>最近记账</text><text class="muted">查看更多 ›</text></view><view wx:if="{{records.length}}"><view class="record" wx:for="{{records}}" wx:key="id" bindlongpress="remove" data-id="{{item.id}}"><text class="record-icon">{{item.icon}}</text><view class="record-main"><text>{{item.category}}</text><text class="note">今天 {{item.time||'12:30'}}</text></view><text class="record-amount {{item.type}}">{{item.type==='income'?'＋':'－'}}¥{{item.amount}}</text></view></view><view wx:else class="empty">还没有账单，点击下方按钮记一笔</view><button class="float-add" bindtap="add">＋</button></view>
