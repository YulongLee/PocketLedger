<view class="page">
  <view wx:if="{{mode === 'list'}}" class="list-view">
    <view class="ledger-head"><text class="title">账单</text><view class="head-actions"><text bindtap="focusSearch">⌕</text><text>•••</text></view></view>
    <view class="ledger-tools"><view class="month-pill">{{monthLabel}}⌄</view></view>
    <view class="calendar"><view wx:for="{{weekLabels}}" wx:key="*this" class="week-label">{{item}}</view><view wx:for="{{calendar}}" wx:key="key" class="day {{item.selected?'selected':''}}" data-day="{{item.day}}" bindtap="selectDay"><text>{{item.day}}</text><view wx:if="{{item.dot}}" class="day-dot"></view></view></view>
    <view class="day-summary"><view class="day-summary-head"><text>{{selectedDateLabel}}</text><text class="summary-more">›</text></view><view class="day-summary-grid"><view><text>支出</text><text class="summary-number">¥ {{dayExpense}}</text></view><view class="summary-line"></view><view><text>收入</text><text class="summary-number">¥ {{dayIncome}}</text></view></view></view>
  </view>
  <view wx:elif="{{mode === 'detail'}}" class="detail-view">
    <view class="header"><text class="back" bindtap="backToList">‹</text><text class="title">账单详情</text><text class="header-action" bindtap="startEdit">编辑</text></view>
    <view class="detail-card"><view class="big-icon">{{selected.icon}}</view><text class="detail-category">{{selected.category}}</text><text class="detail-amount {{selected.type}}">{{selected.type === 'income' ? '+' : '-'}}¥{{selected.displayAmount}}</text><text wx:if="{{selected.note}}" class="detail-note">{{selected.note}}</text></view>
    <view class="info-card"><view><text>时间</text><text>{{selected.date}} {{selected.time}}</text></view><view><text>类型</text><text>{{selected.type === 'income' ? '收入' : selected.type === 'transfer' ? '转账' : '支出'}}</text></view><view><text>账户</text><text>{{selected.account}}</text></view></view><button class="danger-button" bindtap="removeSelected">删除账单</button>
  </view>
  <view wx:else class="edit-view">
    <view class="header"><text class="back" bindtap="cancelEdit">‹</text><text class="title">编辑账单</text><text class="header-action" bindtap="saveEdit">保存</text></view>
    <view class="type-tabs"><text class="{{edit.type === 'expense' ? 'active' : ''}}" data-type="expense" bindtap="editType">支出</text><text class="{{edit.type === 'income' ? 'active' : ''}}" data-type="income" bindtap="editType">收入</text><text class="{{edit.type === 'transfer' ? 'active' : ''}}" data-type="transfer" bindtap="editType">转账</text></view>
    <view class="amount-input"><text>¥</text><input type="digit" value="{{edit.amount}}" data-field="amount" bindinput="editInput" /></view>
    <view class="category-picker"><text class="label">分类</text><scroll-view scroll-x><view class="category-row"><view wx:for="{{categories}}" wx:key="name" class="category {{edit.category === item.name ? 'selected' : ''}}" data-name="{{item.name}}" bindtap="editCategory"><text>{{item.icon}}</text><text>{{item.name}}</text></view></view></scroll-view></view>
    <view class="form-card"><view><text>备注</text><input placeholder="添加备注" value="{{edit.note}}" data-field="note" bindinput="editInput" /></view><view><text>日期</text><picker mode="date" value="{{edit.date}}" bindchange="editDate"><text>{{edit.date}} ›</text></picker></view><view><text>时间</text><input value="{{edit.time}}" data-field="time" bindinput="editInput" /></view></view><button class="save-button" bindtap="saveEdit">保存修改</button>
  </view>
</view>
