.page{padding:30rpx;background:#f5fbf7;min-height:100vh}.profile{display:flex;align-items:center;background:#dff7e8;border-radius:24rpx;padding:32rpx;margin-bottom:24rpx}.avatar{width:100rpx;height:100rpx;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:48rpx;margin-right:22rpx}.name{display:block;font-size:34rpx;font-weight:600}.muted{display:block;color:#84968b;font-size:23rpx;margin-top:8rpx}.card{background:#fff;border-radius:22rpx;padding:0 26rpx}.card view{display:flex;justify-content:space-between;padding:30rpx 0;border-bottom:1rpx solid #edf2ee;font-size:28rpx}.card view:last-child{border:0}.card text{color:#94a39a;font-size:24rpx}
